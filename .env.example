# Go ChainTracks Service - Server Environment Configuration
#
# This file is a TEMPLATE. The server loads a file named ".env" (via godotenv)
# on startup - not this file. Copy it to .env first, then customize:
#   cp .env.example .env
#
# All variables use the CHAINTRACKS_ prefix (required by viper).

# API server port
CHAINTRACKS_PORT=3011

# P2P network: main, test, or teratest
CHAINTRACKS_CHAINTRACKS_P2P_NETWORK=main

# Storage path for Chaintracks data (default: ~/.chaintracks)
CHAINTRACKS_CHAINTRACKS_STORAGE_PATH=~/.chaintracks

# Bootstrap source for initial header sync (embedded mode).
# When these are unset, the server's built-in default performs NO HTTP
# bootstrap and syncs headers via P2P only. The values below are a template
# convenience that enables the recommended TypeScript CDN-style bootstrap:
CHAINTRACKS_CHAINTRACKS_BOOTSTRAP_URL=https://chaintracks-cdn-us-1.bsvb.tech
CHAINTRACKS_CHAINTRACKS_BOOTSTRAP_MODE=cdn
#
# Alternate: gorillanode-style binary API bootstrap. To use it, comment out
# the two lines above and uncomment the two below:
#   CHAINTRACKS_CHAINTRACKS_BOOTSTRAP_URL=https://mainnet.gorillanode.io/api/v1
#   CHAINTRACKS_CHAINTRACKS_BOOTSTRAP_MODE=api
