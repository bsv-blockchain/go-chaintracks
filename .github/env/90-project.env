# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-chaintracks
# Load Order: 90 (loaded after all defaults, overrides everything except 99-local.env)
#
# This file contains project-specific configuration that overrides the defaults
# defined in the 00-xx numbered env files. Only include variables that differ
# from the defaults.
#
# Maintainer: @mrz1836
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Primary Go version for builds and primary test runner
GO_PRIMARY_VERSION=1.25.x

# Secondary Go version for compatibility testing
GO_SECONDARY_VERSION=1.25.x

# MAGE-X Go version overrides
MAGE_X_GO_VERSION=1.25.x
MAGE_X_GO_SECONDARY_VERSION=1.25.x

# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Coverage Provider Selection
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusions (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/

# ================================================================================================
# 🔒 SECURITY CONFIGURATION
# ================================================================================================

# Nancy CVE Exclusions (known acceptable vulnerabilities)
NANCY_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-26014,CVE-2026-26958

# Govulncheck/Magex CVE Exclusions
MAGE_X_CVE_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-26014,CVE-2026-26958

# CVE-2026-26958 for filippo.io/edwards25519 (EXCLUDED: No upstream fix available)
#
# Vulnerability: CVE-2026-26958 CWE-665: Improper Initialization
#  Affected package: filippo.io/edwards25519@v1.1.0
#  Current version: v1.2.0 (latest, upgraded 2026-02-28)
#  Rationale: Upgraded to v1.2.0 (latest). OSS Index may still flag; excluded as safety net.

# CVE-2026-26014 for pion/dtls (EXCLUDED: Invalid/non-existent CVE)
#
# Vulnerability: CVE-2026-26014
#    False positive from Nancy scan - this CVE does not exist in public databases
#    (NVD, OSS Index, or pion/dtls security advisories as of 2026-02-12)
#  Affected packages: github.com/pion/dtls/v2@v2.2.12, github.com/pion/dtls/v3@v3.0.10
#  Current versions: v2.2.12 (latest v2), v3.1.2 (latest v3, includes security fixes)
#  Rationale: No actual vulnerability exists. Nancy likely reporting stale/incorrect data.
#  Resolution: Excluded as false positive. Already using latest pion/dtls versions.

# CVE-2025-64702 for quic-go@v0.55.0
#
# Vulnerability #1: GO-2024-3218
#    Content Censorship in the InterPlanetary File System (IPFS) via Kademlia DHT
#    abuse in github.com/libp2p/go-libp2p-kad-dht
#  More info: https://pkg.go.dev/vuln/GO-2024-3218
#  Module: github.com/libp2p/go-libp2p-kad-dht
#    Found in: github.com/libp2p/go-libp2p-kad-dht@v0.35.1

# ================================================================================================
# ✨ FEATURE FLAGS
# ================================================================================================

# Disable fuzz testing to resolve timeout issues
ENABLE_FUZZ_TESTING=false
