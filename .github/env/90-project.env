# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-chaintracks
# Load Order: 90 (loaded after all defaults, overrides everything except 99-local.env)
#
# This file contains project-specific configuration that overrides the defaults
# defined in the 00-xx numbered env files. Only include variables that differ
# from the defaults.
#
# Maintainer: @mrz1836
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Primary Go version for builds and primary test runner
GO_PRIMARY_VERSION=1.27.x

# Secondary Go version for compatibility testing
GO_SECONDARY_VERSION=1.27.x

# MAGE-X Go version overrides
MAGE_X_GO_VERSION=1.27.x
MAGE_X_GO_SECONDARY_VERSION=1.27.x

# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Coverage Provider Selection
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusions (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/

# ================================================================================================
# 🔒 SECURITY CONFIGURATION
# ================================================================================================

# Nancy CVE Exclusions (known acceptable vulnerabilities)
# Trailing entries (containerd/v2, golang.org/x/image) are unreachable transitive deps
# pulled by teranode/gonum; they cannot be upgraded directly (go mod tidy prunes the bump
# since they are never imported), and govulncheck reports no reachable code paths.
#
# CVE-2026-118653 / GHSA-246p-cpwv-v3jq and CVE-2026-118651 / GHSA-99jh-6h7p-pp36
# (github.com/labstack/echo/v4, all versions <= v4.16.2): the default IP extractor
# trusts X-Forwarded-For (rate limiter bypass) and the proxy middleware forwards a
# caller-supplied X-Real-IP. echo/v4 is pulled transitively via teranode/services/p2p,
# of which this service uses only message types; it never starts teranode's echo
# server and uses no echo middleware, so neither path is reachable here. Only echo/v5
# is fixed and v4.16.2 is the last v4 release. Remove these exclusions once teranode
# moves off echo/v4.
NANCY_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-26014,CVE-2026-26958,CVE-2025-15558,CVE-2026-33747,CVE-2026-33748,CVE-2026-33809,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-39882,CVE-2026-39883,CVE-2026-35469,CVE-2026-5160,CVE-2026-33813,CVE-2026-33812,CVE-2026-46599,CVE-2026-42500,CVE-2026-53488,CVE-2026-53492,CVE-2026-47262,CVE-2026-53489,CVE-2026-50195,CVE-2026-46601,CVE-2026-46602,CVE-2026-46604,CVE-2026-53624,CVE-2026-15789,CVE-2026-15792,CVE-2026-15788,CVE-2026-15791,CVE-2026-54908,CVE-2026-49834,CVE-2026-118653,CVE-2026-118651

# Govulncheck/Magex CVE Exclusions
MAGE_X_CVE_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-26014,CVE-2026-26958,CVE-2025-15558,CVE-2026-33747,CVE-2026-33748,CVE-2026-33809,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-39882,CVE-2026-39883,CVE-2026-35469,CVE-2026-5160,CVE-2026-33813,CVE-2026-33812,CVE-2026-46599,CVE-2026-42500,CVE-2026-53488,CVE-2026-53492,CVE-2026-47262,CVE-2026-53489,CVE-2026-50195,CVE-2026-46601,CVE-2026-46602,CVE-2026-46604,CVE-2026-53624,CVE-2026-15789,CVE-2026-15792,CVE-2026-15788,CVE-2026-15791,CVE-2026-54908,CVE-2026-49834,GO-2026-5932,CVE-2026-118653,CVE-2026-118651
