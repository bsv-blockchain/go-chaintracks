# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-chaintracks
# Load Order: 90 (loaded after all defaults, overrides everything except 99-local.env)
#
# This file contains project-specific configuration that overrides the defaults
# defined in the 00-xx numbered env files. Only include variables that differ
# from the defaults.
#
# Maintainer: @mrz1836
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Primary Go version for builds and primary test runner
GO_PRIMARY_VERSION=1.26.x

# Secondary Go version for compatibility testing
GO_SECONDARY_VERSION=1.26.x

# MAGE-X Go version overrides
MAGE_X_GO_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Coverage Provider Selection
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusions (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/

# ================================================================================================
# 🔒 SECURITY CONFIGURATION
# ================================================================================================

# Nancy CVE Exclusions (known acceptable vulnerabilities)
# Trailing entries (containerd/v2, golang.org/x/image) are unreachable transitive deps
# pulled by teranode/gonum; they cannot be upgraded directly (go mod tidy prunes the bump
# since they are never imported), and govulncheck reports no reachable code paths.
NANCY_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-26014,CVE-2026-26958,CVE-2025-15558,CVE-2026-33747,CVE-2026-33748,CVE-2026-33809,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-39882,CVE-2026-39883,CVE-2026-35469,CVE-2026-5160,CVE-2026-33813,CVE-2026-33812,CVE-2026-46599,CVE-2026-42500,CVE-2026-53488,CVE-2026-53492,CVE-2026-47262,CVE-2026-53489,CVE-2026-50195,CVE-2026-46601,CVE-2026-46602,CVE-2026-46604,CVE-2026-53624,CVE-2026-15789,CVE-2026-15792,CVE-2026-15788,CVE-2026-15791,CVE-2026-54908,CVE-2026-49834

# Govulncheck/Magex CVE Exclusions
MAGE_X_CVE_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-26014,CVE-2026-26958,CVE-2025-15558,CVE-2026-33747,CVE-2026-33748,CVE-2026-33809,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-39882,CVE-2026-39883,CVE-2026-35469,CVE-2026-5160,CVE-2026-33813,CVE-2026-33812,CVE-2026-46599,CVE-2026-42500,CVE-2026-53488,CVE-2026-53492,CVE-2026-47262,CVE-2026-53489,CVE-2026-50195,CVE-2026-46601,CVE-2026-46602,CVE-2026-46604,CVE-2026-53624,CVE-2026-15789,CVE-2026-15792,CVE-2026-15788,CVE-2026-15791,CVE-2026-54908,CVE-2026-49834,GO-2026-5932
